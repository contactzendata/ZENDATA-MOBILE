f_gtESrc() =>
    c0 = array.get(comboHist, 0)
    c1 = array.get(comboHist, 1)
    c2 = array.get(comboHist, 2)
    c3 = array.get(comboHist, 3)
    c4 = array.get(comboHist, 4)
    c5 = array.get(comboHist, 5)
    c6 = array.get(comboHist, 6)
    c7 = array.get(comboHist, 7)
    e0 = array.get(eSrcHist, 0)
    e1 = array.get(eSrcHist, 1)
    e2 = array.get(eSrcHist, 2)
    e3 = array.get(eSrcHist, 3)
    eSum = e0 + e1 + e2 + e3
    table.cell(gt, 0, 56, "-- E SOURCE on L+Q --", text_size = size.tiny)
    table.cell(gt, 1, 56, "bars", text_size = size.tiny)
    table.cell(gt, 0, 57, "0 neither (no 3rd cat)", text_size = size.tiny)
    table.cell(gt, 1, 57, str.tostring(e0), text_size = size.tiny)
    table.cell(gt, 0, 58, "1 M1 only", text_size = size.tiny)
    table.cell(gt, 1, 58, str.tostring(e1), text_size = size.tiny)
    table.cell(gt, 0, 59, "2 M5 ONLY (M5 gain)", text_size = size.tiny)
    table.cell(gt, 1, 59, str.tostring(e2), text_size = size.tiny)
    table.cell(gt, 0, 60, "3 both", text_size = size.tiny)
    table.cell(gt, 1, 60, str.tostring(e3), text_size = size.tiny)
    x0 = array.get(cSrcHist, 0)
    x1 = array.get(cSrcHist, 1)
    x2 = array.get(cSrcHist, 2)
    x3 = array.get(cSrcHist, 3)
    table.cell(gt, 2, 57, "3rd-cat: none", text_size = size.tiny)
    table.cell(gt, 3, 57, str.tostring(x0), text_size = size.tiny)
    table.cell(gt, 2, 58, "3rd-cat: E only", text_size = size.tiny)
    table.cell(gt, 3, 58, str.tostring(x1), text_size = size.tiny)
    table.cell(gt, 2, 59, "3rd-cat: C ONLY", text_size = size.tiny)
    table.cell(gt, 3, 59, str.tostring(x2), text_size = size.tiny)
    table.cell(gt, 2, 60, "3rd-cat: both", text_size = size.tiny)
    table.cell(gt, 3, 60, str.tostring(x3), text_size = size.tiny)
    cSum = x0 + x1 + x2 + x3
    table.cell(gt, 4, 61, (eSum == cSum and eSum == gfStgLQ) ? "AGREE" : ("eSrc " + str.tostring(eSum) + " cSrc " + str.tostring(cSum) + " LQ " + str.tostring(gfStgLQ)), text_size = size.tiny)
    table.cell(gt, 0, 61, "E src sum vs L+Q", text_size = size.tiny)
    table.cell(gt, 1, 61, str.tostring(eSum), text_size = size.tiny)
    table.cell(gt, 2, 61, str.tostring(gfStgLQ), text_size = size.tiny)
    table.cell(gt, 3, 61, eSum == gfStgLQ ? "OK" : "BAD", text_size = size.tiny)
    t0 = array.get(m7State, 0)
    t1 = array.get(m7State, 1)
    t2 = array.get(m7State, 2)
    t3 = array.get(m7State, 3)
    t4 = array.get(m7State, 4)
    t5 = array.get(m7State, 5)
    m7Sum = t0 + t1 + t2 + t3 + t4 + t5
    table.cell(gt, 0, 62, "E primary", text_size = size.tiny)
    table.cell(gt, 1, 62, ePrimary, text_size = size.tiny)
    table.cell(gt, 2, 62, "denom", text_size = size.tiny)
    table.cell(gt, 3, 62, str.tostring(denomEff, "0.00"), text_size = size.tiny)
    histSum = c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7
    0

