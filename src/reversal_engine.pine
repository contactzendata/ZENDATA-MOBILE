    table.cell(gt, 1, 78, "uncapped " + str.tostring(k1), text_size = size.tiny)
    table.cell(gt, 2, 78, "reduced " + str.tostring(k2), text_size = size.tiny)
    table.cell(gt, 3, 78, "killed " + str.tostring(k3), text_size = size.tiny)
