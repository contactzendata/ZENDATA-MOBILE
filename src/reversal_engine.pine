    table.cell(gt, 1, 79, str.tostring(kSum), text_size = size.tiny)
    table.cell(gt, 2, 79, str.tostring(gfBars), text_size = size.tiny)
    table.cell(gt, 3, 79, kSum == gfBars ? "OK" : "BAD", text_size = size.tiny)
    table.cell(gt, 4, 78, "hostile bars " + str.tostring(h1) + " (cap reachable)", text_size = size.tiny)
