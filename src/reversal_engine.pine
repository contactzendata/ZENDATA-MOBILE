if sweepDebug and barstate.islast
    if na(gt)
        gt := table.new(position.bottom_left, 5, 95, border_width = 1)
    f_gtFunnel()
    f_gtProbes()
    if showCrossCheck
        f_gtDerived()
    f_gtM5()
