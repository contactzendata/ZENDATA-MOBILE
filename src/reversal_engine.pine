    table.cell(gt, 4, 93, str.tostring(array.get(gateThrHist, 3)), text_size = size.tiny)
    monoOK = true
    for mi = 0 to 4
        for mj = 0 to 2
            if array.get(fillHist, mi * 4 + mj) < array.get(fillHist, mi * 4 + mj + 1)
                monoOK := false
    table.cell(gt, 0, 94, "monotonic in threshold", text_size = size.tiny)
