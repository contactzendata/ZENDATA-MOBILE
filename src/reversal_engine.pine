    v2 = array.get(m7EvidHist, 2)
    v3 = array.get(m7EvidHist, 3)
    v4 = array.get(m7EvidHist, 4)
    v5 = array.get(m7EvidHist, 5)
    v6 = array.get(m7EvidHist, 6)
    table.cell(gt, 0, 88, "-- FILL RATE vs catFillMin --", text_size = size.tiny)
    table.cell(gt, 1, 88, "0.00", text_size = size.tiny)
    table.cell(gt, 2, 88, "0.15", text_size = size.tiny)
    table.cell(gt, 3, 88, "0.30", text_size = size.tiny)
    table.cell(gt, 4, 88, "0.45", text_size = size.tiny)
    table.cell(gt, 0, 89, "L (M2)", text_size = size.tiny)
    table.cell(gt, 1, 89, str.tostring(array.get(fillHist, 0)), text_size = size.tiny)
    table.cell(gt, 2, 89, str.tostring(array.get(fillHist, 1)), text_size = size.tiny)
