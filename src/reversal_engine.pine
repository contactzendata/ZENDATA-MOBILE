if sweepDebug and barstate.islast
    if na(ct)
        ct := table.new(position.top_left, 6, 18, border_width = 1)
    f_ctA()
    f_ctB()

// Every module is a stub, so hasSetup is always false. These plots exist so the
// grade series is chartable and alertable the moment the first module goes live.
plot(finalGrade, "Grade (3=A 2=B 1=C)", display = display.data_window)
plot(side,       "Side (1=long -1=short)", display = display.data_window)
plot(showRaw ? composite : na, "Composite (raw)", display = display.data_window)
plot(onRevAdj,   "M8 bias", display = display.data_window)
plot(m6Score,    "M6 score", display = display.data_window)
plot(m6Dir,      "M6 dir",   display = display.data_window)
plot(m6ContribAge, "M6 age at grade (bars)", display = display.data_window)
plot(m2ProxRaw,  "M2 proximity (raw)",     display = display.data_window)
plot(m2Prox,     "M2 proximity (damped)",  display = display.data_window)
plot(m2Stack,    "M2 stacking",            display = display.data_window)
plot(m2Score,    "M2 score",               display = display.data_window)
plot(m1Z,        "M1 z-score (signed)",    display = display.data_window)
plot(m1DistRaw,  "M1 distance (raw)",      display = display.data_window)
plot(m1WalkDamp, "M1 band-walk damp",      display = display.data_window)
plot(m1ExtDamp,  "M1 barrier damp",        display = display.data_window)
plot(m1Score,    "M1 score",               display = display.data_window)
plot(m5AdrTerm,  "M5 ADR term",            display = display.data_window)
plot(m5EmTerm,   "M5 EM term",             display = display.data_window)
plot(m5Score,    "M5 score",               display = display.data_window)
plot(rvolVal,    "RVOL (slot-normalised)", display = display.data_window)
plot(rvolMult,   "RVOL composite mult",    display = display.data_window)
plot(compRaw,    "Composite pre-RVOL",     display = display.data_window)
plot(compRvol,   "Composite post-RVOL",    display = display.data_window)
plot(ctxEvid,    "M7 evidence",            display = display.data_window)
plot(ctxSigned,  "M7 signed consensus",    display = display.data_window)
plot(ctxAdx,     "M7 ADX",                 display = display.data_window)
plot(ungatedGrade, "Grade ungated",        display = display.data_window)

// VWAP and sigma bands. Drawn only when not blind (D-035).
m1PlotOn = vwapShow and not blindMode
plot(m1PlotOn ? m1Vwap : na, "VWAP", color = color.new(color.blue, 0), linewidth = 2)
plot(m1PlotOn and not na(m1Sigma) ? m1Vwap + vwapB1 * m1Sigma : na, "+1s", color = color.new(color.gray, 45))
plot(m1PlotOn and not na(m1Sigma) ? m1Vwap - vwapB1 * m1Sigma : na, "-1s", color = color.new(color.gray, 45))
plot(m1PlotOn and not na(m1Sigma) ? m1Vwap + vwapB2 * m1Sigma : na, "+2s", color = color.new(color.orange, 25))
plot(m1PlotOn and not na(m1Sigma) ? m1Vwap - vwapB2 * m1Sigma : na, "-2s", color = color.new(color.orange, 25))
plot(m1PlotOn and not na(m1Sigma) ? m1Vwap + vwapB3 * m1Sigma : na, "+2.5s", color = color.new(color.red, 20))
plot(m1PlotOn and not na(m1Sigma) ? m1Vwap - vwapB3 * m1Sigma : na, "-2.5s", color = color.new(color.red, 20))
